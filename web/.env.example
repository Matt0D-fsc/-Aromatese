# Copy to .env.local and fill in. Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Used in invite / password-reset links. Defaults to the request origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI auto-fill for product onboarding
GEMINI_API_KEY=
# Testing only: extra keys from your other Google accounts, comma separated.
# When one key hits its daily free limit, the next one takes over. Production: one key with billing on.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.6-flash

# Facebook Messenger and Instagram. Meta app dashboard -> App settings -> Basic.
META_APP_ID=
META_APP_SECRET=
# A password you choose. Paste the same one into the webhook setup form in the Meta app dashboard.
META_VERIFY_TOKEN=
# Optional: pin the Graph API version. Defaults to v23.0.
META_GRAPH_VERSION=

# Shown on the privacy policy page. Meta's app review expects a real, monitored contact.
NEXT_PUBLIC_PRIVACY_CONTACT=
