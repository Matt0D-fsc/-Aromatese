{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // DOM for fetch, Response and RequestInit, which the tests drive directly.
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"],
    "paths": { "@/*": ["./web/src/*"] }
  },
  "include": ["tests/**/*", "vitest.config.ts"],
  "exclude": ["node_modules", "web"]
}
